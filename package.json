{
  "name": "skill-xhs-travel-plan",
  "version": "1.0.0",
  "description": "Agent skill for generating Chinese mobile travel-guide HTML from local route notes and photos.",
  "type": "module",
  "scripts": {
    "scan": "node scripts/scan_resources.mjs",
    "create-workspace": "node scripts/create_fact_workspace.mjs",
    "create-queue": "node scripts/create_reading_queue.mjs",
    "create-digest": "node scripts/create_source_digest_workspace.mjs",
    "create-read-log": "node scripts/create_read_log.mjs",
    "apply-facts-patch": "node scripts/apply_facts_patch.mjs",
    "validate-digest": "node scripts/validate_source_digest.mjs",
    "apply-digest": "node scripts/apply_source_digest_to_facts.mjs",
    "rag:validate": "node scripts/rag/validate_rag_index.mjs",
    "rag:retrieve": "node scripts/rag/rag_retrieve.mjs",
    "rag:workspace": "node scripts/rag/create_retrieval_workspace.mjs",
    "render": "node scripts/render_travel_html.mjs",
    "verify": "node scripts/verify_output.mjs",
    "assessment:params": "node scripts/assessment/rag-tuning/lib/params_snapshot.mjs",
    "assessment:prepare": "node scripts/assessment/rag-tuning/prepare_run.mjs",
    "assessment:baseline": "node scripts/assessment/rag-tuning/build_baseline_checklist.mjs",
    "assessment:evaluate": "node scripts/assessment/rag-tuning/evaluate_run.mjs",
    "assessment:rerank-ab": "node scripts/assessment/rag-tuning/compare_rerank_ab.mjs",
    "assessment:upgrade": "node scripts/assessment/rag-tuning/upgrade_baseline.mjs",
    "test": "node --test",
    "assessment:ceiling": "node scripts/assessment/rag-tuning/build_ceiling_baseline.mjs --coverage assessment/rag-tuning/baselines/B3-ceiling.coverage.md --out assessment/rag-tuning/baselines/B3-ceiling.checklist.json",
    "assessment:ceiling-menu": "node scripts/assessment/rag-tuning/build_ceiling_baseline.mjs --emit-menu assessment/rag-tuning/baselines/B3-ceiling.coverage.md && node scripts/assessment/rag-tuning/build_ceiling_baseline.mjs --emit-menu assessment/rag-tuning/baselines/TEMPLATE-ceiling-coverage.md"
  },
  "dependencies": {
    "ejs": "^6.0.1"
  }
}
